# ─────────────────────────────────────────────────────────────
# Доставка заявок с форм (скопируйте в .env.local и заполните)
# ─────────────────────────────────────────────────────────────

# SMTP — основной канал, письмо на почту.
# Пример для Яндекс 360 (почта info@eracoffee.ru):
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
#   SMTP_USER=info@eracoffee.ru
#   SMTP_PASS=пароль_приложения   (создаётся в настройках Яндекс ID, НЕ обычный пароль)
#   SMTP_FROM=ERA Coffee <info@eracoffee.ru>
#   LEAD_EMAIL_TO=info@eracoffee.ru
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_EMAIL_TO=

# Telegram — опциональные мгновенные уведомления о заявках (дубль к почте).
# Создайте бота у @BotFather → токен; узнайте chat_id (напр. через @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────
# Аналитика (опционально — если пусто, счётчики не подключаются)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
